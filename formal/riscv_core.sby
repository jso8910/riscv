[options]
mode bmc
depth 20

[engines]
# The proof has one SBY task, so SBY -j cannot parallelize it.  Let Z3 use
# multiple cores for the expensive incremental BMC solve instead.
smtbmc z3 smt.threads=8

[script]
plugin -i /usr/share/yosys/plugins/slang.so
read_slang --single-unit --top riscv_core -D FORMAL -f sim/core_rtl.f
prep -top riscv_core

