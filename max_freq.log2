@file(genus_max_freq.tcl) 48: if {[llength $LIB_FILES] == 0} {
    error "LIB_FILES is empty."
}
@file(genus_max_freq.tcl) 51: foreach lib $LIB_FILES {
    if {![file isfile $lib]} {
        error "Liberty file does not exist: $lib"
    }
}
@file(genus_max_freq.tcl) 56: if {![file isfile $CONSTRAINTS_FILE]} {
    error "Constraints file does not exist: $CONSTRAINTS_FILE"
}
@file(genus_max_freq.tcl) 59: if {$SEARCH_MIN_PERIOD_NS <= 0.0 || $SEARCH_MAX_PERIOD_NS <= 0.0 ||
    $SEARCH_MIN_PERIOD_NS >= $SEARCH_MAX_PERIOD_NS || $SEARCH_RESOLUTION_NS <= 0.0} {
    error "Require 0 < SEARCH_MIN_PERIOD_NS < SEARCH_MAX_PERIOD_NS and SEARCH_RESOLUTION_NS > 0."
}
@file(genus_max_freq.tcl) 64: proc read_project_filelist ...
@file(genus_max_freq.tcl) 85: set rtl_sources [read_project_filelist [file join $root_dir sim rtl.f] $root_dir]
@file(genus_max_freq.tcl) 86: foreach source $rtl_sources {
    if {![file isfile $source]} {
        error "RTL source listed in sim/rtl.f does not exist: $source"
    }
}
@file(genus_max_freq.tcl) 92: file mkdir $results_root
@file(genus_max_freq.tcl) 93: set run_tag [clock format [clock seconds] -format "%Y%m%d_%H%M%S"]
@file(genus_max_freq.tcl) 94: set search_report [file join $results_root search_${run_tag}.rpt]
@file(genus_max_freq.tcl) 95: set search_fh [open $search_report w]
@file(genus_max_freq.tcl) 96: puts $search_fh "# period_ns wns_ns setup_closed"
@file(genus_max_freq.tcl) 98: set_db library         $LIB_FILES

